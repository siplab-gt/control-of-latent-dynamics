        "scripts/cleo_prep.py"


rule plot_fsnn:
    input:
        f"results/{params_str}/trained_fsnn.pkl",
        "src/plot_style.py",
    output:
        f"results/{params_str}/fsnn_plot.png",
    localrule: True
    script:
        "scripts/plot_fsnn.py"


rule train_fsnn:
    output:
        f"results/{params_str}/trained_fsnn.pkl",
    log:
        **standard_log_kwargs("train_fsnn"),
    script:
        "scripts/train_fsnn.py"
