        task_specific=task_specific_params,
        # n_trials_sys_id_max=config["star_sweep_conds"]["n_trials_sys_id"][-1],
    output:
        f"results/{params_str}/sys_id_data.pkl",
        # just run once with maximum number of trials
        # split up later during fit
        # paths_for_params("sys_id_data.pkl", n_trials_sys_id="all"),
        # this produces an error. leave wildcard, but n_trials_sys_id='all' should
        # be the only thing this rule produces
    script:
        "scripts/sys_id_expts.py"


