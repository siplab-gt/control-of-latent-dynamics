def na_wildcards_before_step(desired_step):
    """returns a {wc: "NA"} dict for all wildcards that are irrelevant before
    the desired step. e.g., for model fit, the WCs introduced by model_fit and later"""
    irrelevant_wcs = []
    for step, step_irrs in [
        ("ctrl_expts", ["latency", "ctrl_type"]),
        ("model_fit", ["n_trials_sys_id", "model_task_inputs"]),
        ("sys_id_expts", []),
        ("cleo_prep", ["beam_width_um", "beam_spacing", "k", "m"]),
    ]:
        irrelevant_wcs += step_irrs
        if step == desired_step:
            break
    return {wc: NA for wc in irrelevant_wcs}


# whatever the output is, ask for the fit from non-control-relevant parameters (latency, control)
rule ctrl_expts:
    input:
        "src/ctrl/__init__.py",
        "src/ctrl/{ctrl_type}.py",
        cleo_prep=paths_for_params(
            "cleo_prep.pkl", **na_wildcards_before_step("sys_id_expts")
        ),
        braid_model=paths_for_params(
            "braid_model.pkl", **na_wildcards_before_step("ctrl_expts")
        ),
    params:
        **params_from_cfg("expts", keep_target_key=False),
        **params_from_cfg("controller", keep_target_key=False),
        expts=params_from_cfg_with_wildcards(
            "task_specific/{task}/expts", keep_target_key=False
        ),
    output:
        f"results/{params_str}/ctrl_data.pkl",
        # NOTE: maybe instead of just data.npz have separate files U.npy, R.npy, etc.?
        # or a CtrlData dataclass
    script:
        "../src/scripts/ctrl_expts.py"


rule model_fit:
    input:
        paths_for_params("sys_id_data.pkl", **na_wildcards_before_step("model_fit")),
    params:
        model_fit=params_from_cfg_with_wildcards(
            "task_specific/{task}/model_fit", keep_target_key=False
        ),
        comp_graph_plot_basename=f"results/{params_str}/model_graph",
    output:
        braid_model=f"results/{params_str}/braid_model.pkl",
        logs_plot=f"results/{params_str}/braid_model_logs.png",
        pred_plot=f"results/{params_str}/braid_model_pred_plot.png",
    script:
        "../src/scripts/model_fit.py"


