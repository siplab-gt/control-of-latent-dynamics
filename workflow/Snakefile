import pandas as pd

# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


configfile: "config/config.yaml"


rule all:
    input:
        expand(
            "results/figs/sufficient_stim-{task}.svg",
            task=config["manual_sweep_conds"]["task"],
        ),
        # "results/figs/stim-rec-balance.svg",
        # "results/figs/realism.svg",


cond_params = [
    param
    for param_type in ["manual_sweep_conds", "grid_sweep_conds", "star_sweep_conds"]
    for param in config[param_type].keys()
]

params_str = "/".join(f"{par}_{{{par}}}" for par in cond_params)


def paths_for_params(file: list | str, **kwargs) -> str:
    params = config["reference_conds"] | kwargs
    wildcards = set(cond_params) - params.keys()
    # need to mask wildcards we want to keep with double braces
    params_str_masked = params_str
    for wc in wildcards:
        params_str_masked = params_str_masked.replace(f"{{{wc}}}", f"{{{{{wc}}}}}")
    return expand(
        f"results/{params_str_masked}/{{file}}",
        file=file,
        **params,
    )


def params_from_cfg(*params: str, keep_parents=False, get_children=False) -> dict:
    """easy way to get params from config dict. can go past first level with /"""
    result = {}
    for param in params:
        keys = param.split("/")
        d = result
        subcfg = config
        for key in keys[:-1]:
            if keep_parents:
                if key not in d:
                    d[key] = {}
                d = d[key]
            subcfg = subcfg[key]
        if get_children:
            d |= subcfg[keys[-1]]
        else:
            d[keys[-1]] = subcfg[keys[-1]]
    return result


rule test:
    # for easily running one reference condition
    # (doesn't require a super long path with all wildcards)
    input:
        # f"results/{params_str}/cleo_prep.pkl",
        paths_for_params(
            file="{file}",
            setting="sufficient_stim",
            task="cycling",
            latency=False,
            control="OL",
            k=4,
            m=0,
            seed=0,
            layeredness=1,
        ),
    output:
        "results/test/{file}",
    shell:
        "cp $(dirname {input})/* $(dirname {output})"


rule sufficient_stim_fig:
    input:
        "results/sufficient_stim-{task}.csv",
    output:
        "results/figs/sufficient_stim-{task}.svg",
    script:
        "scripts/sufficient_stim_fig.py"


rule sufficient_stim_tabulate:
    input:
        # expand("results/{params}/{file}", params=paramspace.instance_patterns, ext=[""]),
        # to get main fig
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                control=ctrl,
                m=0,
                k=config["q1"]["k"],
                seed=config["grid_sweep_conds"]["seed"],
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
        ],
        # exploratory variables
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                control=ctrl,
                k=config["q1"]["k"],
                m=0,
                seed=config["grid_sweep_conds"]["seed"],
                **{var: config["star_sweep_conds"][var]},
            )
            for var in config["star_sweep_conds"]
            for ctrl, latency in [("OL", False), ("LQMPC", True)]
        ],
    output:
        "results/sufficient_stim-{task}.csv",
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        df.write_csv(output[0], index=False)


def standard_log_kwargs(log_name):
    return {
        "stdout": f"logs/{params_str}/{log_name}.log",
        "stderr": f"logs/{params_str}/{log_name}.log",
    }


