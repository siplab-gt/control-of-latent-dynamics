rule sufficient_stim_tabulate:
    input:
        # to get main fig
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                ctrl_type=ctrl,
                m=NA,
                k=config["q1"]["k"],
                seed=config["grid_sweep_params"]["seed"],
                signals=NA,
                fill_in_ref=True,
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
        ],
        # exploratory variables
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                ctrl_type=ctrl,
                k=config["q1"]["k"],
                m=NA,
                seed=config["grid_sweep_params"]["seed"],
                signals=NA,
                **{var: config["star_sweep_params"][var]},
                fill_in_ref=True,
            )
            for var in config["star_sweep_params"]
            for ctrl, latency in [("OL", False), ("LQMPC", True)]
        ],
    output:
        protected("results/sufficient_stim_{task}.csv"),
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        print("concatenated sufficient stim DFs")
        df.to_csv(output[0], index=False)
        print(f"wrote sufficient stim results to {output[0]}")


def get_q2_kms():
    budget = int(config["q2"]["channel_budget"])
    kk = np.linspace(
        1, budget - 1, int(config["q2"]["num_stim_ratio_levels"]), endpoint=True
    )
    kk = np.round(kk).astype(int)
    mm = budget - kk
    return zip(kk.tolist(), mm.tolist())


