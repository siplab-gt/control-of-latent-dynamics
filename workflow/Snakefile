# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


configfile: "config/config.yaml"


rule all:
    input:
        expand(
            "results/figs/sufficient_stim_{task}.pdf",
            task=config["manual_sweep_params"]["task"],
        ),


"results/figs/stim-rec-balance.svg",
"results/figs/realism.svg",


cond_params = [
    param
    for param_type in ["manual_sweep_params", "grid_sweep_params", "star_sweep_params"]
    for param in config[param_type].keys()
]

params_str = "/".join(f"{par}_{{{par}}}" for par in cond_params)


def paths_for_params(file: list | str, fill_in_ref=False, **kwargs) -> str:
    params = config["reference_params"].copy() if fill_in_ref else {}
    params |= kwargs
    wildcards = set(cond_params) - params.keys()
    # need to mask wildcards we want to keep with double braces
    params_str_masked = params_str
    for wc in wildcards:
        params_str_masked = params_str_masked.replace(f"{{{wc}}}", f"{{{{{wc}}}}}")
    out = expand(
        f"results/{params_str_masked}/{{file}}",
        file=file,
        **params,
    )
    if len(out) == 1:
        return out[0]
    return out


NA = "NA"  # when a parameter is not applicable (e.g. latency for open-loop control)


def params_from_cfg(*params: str, keep_parent_keys=False, keep_target_key=True) -> dict:
    """easy way to get params from config dict. can go past first level with /"""
    result = {}
    for param in params:
        keys = param.split("/")
        d = result
        subcfg = config
        for key in keys[:-1]:
            if keep_parent_keys:
                if key not in d:
                    d[key] = {}
                d = d[key]
            subcfg = subcfg[key]
        if not keep_target_key:
            d |= subcfg[keys[-1]]
        else:
            d[keys[-1]] = subcfg[keys[-1]]
    return result


def params_from_cfg_with_wildcards(
    *queries: str, keep_parent_keys=False, keep_target_key=True
) -> callable:
    def replace_wildcards(wildcards):
        results = {}
        for query in queries:
            results |= params_from_cfg(
                *expand(query, **wildcards),
                keep_parent_keys=keep_parent_keys,
                keep_target_key=keep_target_key,
            )
        # print(f"{results=}")
        return results

    return replace_wildcards


def step_params(*steps: str) -> callable:
    def wc_fn(wildcards):
        params = {}
        for step in steps:
            params |= config[step]
            if "task_specific" in params:
                params |= config[step]["task_specific"][wildcards.task]
                del params["task_specific"]
        return params

    return wc_fn


