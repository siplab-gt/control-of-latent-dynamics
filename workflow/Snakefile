from snakemake.utils import Paramspace
import pandas as pd

# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


configfile: "config/config.yaml"


TASKS = ["cycling", "reaching", "integration"]


rule all:
    input:
        # "results/conditions.csv",
        expand("results/figs/sufficient-stim-{task}.svg", task=TASKS),
        # "results/figs/stim-rec-balance.svg",
        # "results/figs/realism.svg",


paramspace = Paramspace(pd.read_csv("results/conditions.csv"))

exploratory_vars = [
    "n_trials_sys_id",
    "latent_dim",
    "total_scale",
    "network_area_scale",
    "beam_width_um",
    "beam_spacing",
    "connection_distance_penalty",
    "connection_l2_penalty",
    "layer_structure",
    "dales_law",
]

all_vars = ["setting", "task", "seed", "control", "k", "m"] + sorted(exploratory_vars)

params_str = "/".join(f"{var}_{{{var}}}" for var in all_vars)


def paths_for_params(file: list | str, **kwargs) -> str:
    params = config["reference_configuration"] | kwargs
    wildcards = set(all_vars) - params.keys()
    # need to mask wildcards we want to keep
    params_str_masked = params_str
    for wc in wildcards:
        params_str_masked = params_str_masked.replace(f"{{{wc}}}", f"{{{{{wc}}}}}")
    return expand(
        f"results/{params_str_masked}/{{file}}",
        file=file,
        **params,
    )


rule test:
    # for easily running one reference condition
    # (doesn't require a super long path with all wildcards)
    input:
        # f"results/{params_str}/fsnn_with_cleo.pkl",
        paths_for_params(
            file="{file}",
            setting="sufficient-stim",
            task="cycling",
            latency=False,
            control="OL",
            k=1,
            m=0,
            seed=0,
        ),
    output:
        "results/test/{file}",
    shell:
        "cp {input} {output}"


rule sufficient_stim_fig:
    input:
        "results/sufficient-stim-{task}.csv",
    output:
        "results/figs/sufficient-stim-{task}.svg",
    script:
        "scripts/sufficient_stim_fig.py"


rule sufficient_stim_tabulate:
    input:
        # expand("results/{params}/{file}", params=paramspace.instance_patterns, ext=[""]),
        # to get main fig
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient-stim",
                latency=latency,
                control=ctrl,
                k=config["q1"]["k"],
                m=0,
                seed=config["seed"],
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
        ],
        # exploratory variables
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient-stim",
                latency=latency,
                control=ctrl,
                k=config["q1"]["k"],
                m=0,
                seed=config["seed"],
                **{var: config[var]},
            )
            for var in exploratory_vars
            for ctrl, latency in [("OL", False), ("LQMPC", True)]
        ],
    output:
        "results/sufficient-stim-{task}.csv",
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        df.write_csv(output[0], index=False)


def standard_log_kwargs(log_name):
    return {
        "stdout": f"logs/{params_str}/{log_name}.log",
        "stderr": f"logs/{params_str}/{log_name}.log",
    }


rule analyze_ctrl_data:
    input:
        f"results/{params_str}/ctrl_data.pkl",
    output:
        f"results/{params_str}/summary.csv",


rule ctrl_expts:
    input:
        f"results/{params_str}/dpad_model.pkl",
        f"results/{params_str}/fsnn_with_cleo.pkl",
        # NOTE: if fSNN is big, maybe store separately from Cleo prep 
        # to avoid redundancy
    output:
        f"results/{params_str}/ctrl_data.pkl",
        # NOTE: maybe instead of just data.npz have separate files U.npy, R.npy, etc.?
        # or a CtrlData dataclass


rule sys_id_fit:
    input:
        f"results/{params_str}/sys_id_data.pkl",
    output:
        f"results/{params_str}/dpad_model.pkl",


rule sys_id_expts:
    input:
        f"results/{params_str}/fsnn_with_cleo.pkl",
    output:
        f"results/{params_str}/sys_id_data.pkl",


rule plot_cleo:
    input:
        f"results/{params_str}/fsnn_with_cleo.pkl",
        "src/plot_style.py",
    output:
        f"results/{params_str}/cleo_plot.png",
    localrule: True
    script:
        "scripts/plot_cleo.py"


rule cleo_prep:
    input:
        f"results/{params_str}/trained_fsnn.pkl",
        "src/grouped_light.py",
    output:
        f"results/{params_str}/fsnn_with_cleo.pkl",
