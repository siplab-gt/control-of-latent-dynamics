# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.


# NOTE: configfiles must be supplied on the CLI via two `--configfile` flags
# (one for params, one for sweeps). They are NOT defaulted at the top of this
# Snakefile because Snakemake's `--configfile` performs a deep merge with any
# defaults declared here, which would leak production sweep axes into
# lightweight runs (e.g. testconfig / ultra_light) and explode the DAG.
#
# The smk-submit-slurm.sbatch wrapper enforces both flags; for direct
# invocation use:
#     snakemake --configfile config/<name>_params.yaml \
#               --configfile config/<name>_sweeps.yaml ...
if "params" not in config or "sweeps" not in config:
    raise ValueError(
        "Snakefile requires both `params:` and `sweeps:` blocks in the merged "
        "config. Pass two --configfile flags: <name>_params.yaml and "
        "<name>_sweeps.yaml. See smk-submit-slurm.sbatch for an example."
    )


def _sweep_or_default(key):
    """Return the list of values for `key` from config['sweeps'], or a
    single-element list containing the default from config['params']."""
    if key in config.get("sweeps", {}):
        return list(config["sweeps"][key])
    return [config["params"][key]]


def _wc_constraint(key, extras=()):
    """Build a wildcard regex constraint from sweeps + extra alternatives.
    Single-value (default-only) keys still produce a valid regex."""
    vals = [str(v) for v in _sweep_or_default(key)] + list(extras)
    return "|".join(vals)


wildcard_constraints:
    task=_wc_constraint("task"),
    setting=_wc_constraint("setting", extras=("NA",)),
    ctrl_type=_wc_constraint("ctrl_type", extras=("NULL",)),
    ctrl_horizon_ms=r"\d+",
    nlmpc_grad_iters=r"\d+",
    cz2_warm="ridge|random",


