steps_params = {
    "prep_fsnn": [
        "task",
        "seed",
        "n_latent_dims_offset",
        "density_scale",
        "network_area_scale",
    ],
    "cleo_prep": [
        "setting",
        "k",
        "m",
        "beam_width_um",
        "signals",
    ],
    "sys_id_expts": [],
    "model_fit": ["n_trials_sys_id", "model_task_inputs"],
    "ctrl_expts": ["latency", "ctrl_type", "ctrl_horizon_ms", "nlmpc_iters"],
    "analysis": [],
}


all_cond_params = []
for p in steps_params.values():
    all_cond_params.extend(p)

# Validate every sweep axis is a recognized condition param.
for p in config.get("sweeps", {}).keys():
    assert p in all_cond_params, (
        f"sweep key {p!r} is not a recognized condition param; "
        f"valid keys: {sorted(all_cond_params)}"
    )
# Validate every condition param has a default in `params`.
for p in all_cond_params:
    if p in ("k", "m"):
        # k/m are generated from q_usid (channel_budget × num_stim_ratio_levels);
        # defaults exist for testq_usid convenience only.
        continue
    assert p in config["params"], (
        f"params block missing default for {p!r}; every condition param "
        "must have a single default value in the params file."
    )


def step_from_filename(filename: str) -> str:
    if "fsnn" in filename:
        return "prep_fsnn"
    elif "cleo" in filename:
        return "cleo_prep"
    elif "natural_electrode" in filename:
        return "sys_id_expts"
    elif "sys_id" in filename:
        return "sys_id_expts"
    elif "usid" in filename:
        return "sys_id_expts"
    elif "model_fit" in filename:
        return "model_fit"
    elif "ctrl" in filename:
        return "ctrl_expts"
    else:
        return "analysis"


@cache
def cond_params_for_step(step: str) -> list[str]:
    """get the list of exploratory parameters relevant for a given step"""
    params = []
    for s, p in steps_params.items():
        params.extend(p)
        # cut the path short since only irrelevant params after this step
        if s == step:
            break
    return params


def wildcard_path(file: str, fill_in_defaults=False, **kwargs) -> str:
    step = step_from_filename(file)
    params = config["params"].copy() if fill_in_defaults else {}
    params |= kwargs
    wildcards = set(all_cond_params) - params.keys()

    cond_params = cond_params_for_step(step)

    for kw in kwargs:
        if kw in cond_params:
            warnings.warn(f"requested keyword {kw} is irrelevant at step {step}")
    for p in list(params):
        if p not in cond_params:
            del params[p]

    params_str = "/".join(f"{par}_{{{par}}}" for par in cond_params)

    if file.endswith(".log"):
        parent_dir = "<logs>"
    else:
        parent_dir = "<results>"

    # need to mask wildcards we want to keep with double braces
    params_str_masked = params_str
    for wc in wildcards:
        params_str_masked = params_str_masked.replace(f"{{{wc}}}", f"{{{{{wc}}}}}")
    out = expand(
        f"{parent_dir}/{params_str_masked}/{{file}}",
        file=file,
        **params,
    )
    if len(out) == 1:
        return out[0]
    return out


NA = "NA"  # when a parameter is not applicable (e.g. latency for open-loop control)


def params_from_cfg(*params: str, keep_parent_keys=False, keep_target_key=True) -> dict:
    """easy way to get params from config dict. can go past first level with /"""
    result = {}
    for param in params:
        keys = param.split("/")
        d = result
        subcfg = config
        for key in keys[:-1]:
            if keep_parent_keys:
                if key not in d:
                    d[key] = {}
                d = d[key]
            subcfg = subcfg[key]
        if not keep_target_key:
            d |= subcfg[keys[-1]]
        else:
            d[keys[-1]] = subcfg[keys[-1]]
    return result


def params_from_cfg_with_wildcards(
    *queries: str, keep_parent_keys=False, keep_target_key=True
) -> callable:
    def replace_wildcards(wildcards):
        results = {}
        for query in queries:
            results |= params_from_cfg(
                *expand(query, **wildcards),
                keep_parent_keys=keep_parent_keys,
                keep_target_key=keep_target_key,
            )
        # print(f"{results=}")
        return results

    return replace_wildcards


def step_cfg(*steps: str) -> callable:
    subcfg_vars = ["task", "mode", "setting", "ctrl_type"]

    def wc_fn(wildcards):
        params = {}
        for step in steps:
            params |= config[step]
            for var in subcfg_vars:
                try:
                    params |= config.get(f"{step}_{getattr(wildcards, var)}", {})
                except (KeyError, AttributeError):
                    pass
        return params

    return wc_fn


def configfile_inputs(wildcards=None):
    """Return all configfiles loaded by the workflow.

    Tracking these as rule inputs means any config change (e.g. flipping
    opsin_plant_class, model_fit_method, etc.) invalidates downstream
    outputs via mtime. This is more reliable than Snakemake's
    params-based rerun trigger, which silently misses some cases.
    """
    return list(getattr(workflow, "configfiles", []))


def configfile_inputs_excluding_sweeps(wildcards=None):
    """Per-cell rule variant that excludes `*_sweeps.yaml` from the
    tracked input set. Editing sweep axes (adding/removing seeds,
    controllers, etc.) only changes which cells the AGGREGATOR demands;
    each per-cell computation is independent of the sweep specification,
    so its cached output should NOT be invalidated by a sweep edit.

    Use this for per-cell rules (cleo_prep, sys_id_expts, model_fit,
    ctrl_expts). The aggregator rule's input list inherently depends on
    the sweep keys, so the aggregator does not need this helper —
    Snakemake's missing-output detection handles re-aggregation when
    sweeps add new cells.
    """
    return [
        c for c in getattr(workflow, "configfiles", [])
        if "_sweeps" not in os.path.basename(c)
    ]


