def fsnn_params(wc):
    """gets all prep_fsnn params, but only task and mode params as needed"""
    params = deepcopy(config["prep_fsnn"])
    try:
        multitask = str2bool(wc.multitask)
    except AttributeError:
        multitask = False
    if multitask:
        for task in ["reaching", "cycling"]:
            params[wc.task] = config[f"prep_fsnn_{wc.task}"]
    else:
        params[wc.task] = config[f"prep_fsnn_{wc.task}"]

    if "mode" in wc.keys():
        params |= config[f"prep_fsnn_{wc.mode}"]

    # include array side length since network size depends on it
    params["array_side_length_mm"] = config["cleo_prep"]["array_side_length_mm"]
    params["report_period_s"] = config["report_period_s"]
    return params


