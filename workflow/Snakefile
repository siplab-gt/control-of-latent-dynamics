def fsnn_mem_required(wc):
    return 4000 * (1 + float(wc["density_scale"]) * float(wc["network_area_scale"]) / 6)


def runtime_min(n_trials, n_train_trials=0, multiplier=1):
    def f(wc):
        scale = float(wc["density_scale"]) * float(wc["network_area_scale"])
        # observed per-trial runtimes for small networks
        # got 5.4 seconds per trial for demean on big network (*6)
        # get ~1s/trial on Myelin, but ~7 for PACE.
        # actually, around 16 on average for control on PACE.
        # scales less than quadratically
        trial_runtime_min = 16 / 60 * scale**1.2 * multiplier
        # scales quadratically (with synapses)
        train_trial_runtime_min = 60 / 60 * scale**2 * multiplier

        runtime = 2  # overhead
        runtime += n_trials * trial_runtime_min
        runtime += n_train_trials * train_trial_runtime_min
        return ceil(runtime)

    return f


def _ctrl_expts_runtime(wildcards, attempt):
    """Empirical wall-time allocation for ctrl_expts, in minutes.

    Per-trial wall (100 trials) is dominated by the closed-loop Brian2 sim plus a
    horizon-length L-BFGS-B / iLQR solve whose iteration count is convergence-driven,
    NOT the nlmpc_grad_iters cap. The old `7 + H*N/150` form assumed the solver runs
    all N iters; L-BFGS-B converges far short of the cap, so the request was ~10x the
    real wall (e.g. 34 h reserved for a ~3 h NLMPC@N=300 cell), which barred the cell
    from backfill and the 8-h embers QOS. Measured ~100 s/trial for NLMPC at H=200
    (cells 9825445/24, Jun-2026; ~30 wall-s per simulated-s). Model as a Brian2 base
    + per-horizon solver term, INDEPENDENT of the grad-iter cap.

    `attempt`-aware: a retry doubles the wall instead of re-timing-out at the same
    value (the old form re-used the same wall on retry, so an undersized cell failed
    twice). FLOOR_MIN: all controllers get >= 60 min, covering worst-case (k, m)
    Brian2 sim for the cheap controllers (NULL/OL).
    """
    # 1.5 was tuned to the de-saturated ~100 s/trial measurement; the SATURATED
    # phim-low regime runs the NLMPC solver ~2-3x longer (H=200 cells observed ~8 h,
    # timing out at the 1.5x wall, then wasting the killed attempt + a full re-run).
    # Bumped to 3.5 so saturated H=200 cells (~10 h wall) clear on the first attempt.
    # Over-reservation is free (PACE bills walltime USED, not reserved); the only cost
    # is reduced short-job backfill / 8-h-QOS eligibility for the cheaper cells.
    SAFETY_MARGIN = 3.5
    FLOOR_MIN = 60
    if wildcards.ctrl_type in ("NULL", "OL"):
        base = FLOOR_MIN
    else:
        H = int(wildcards.ctrl_horizon_ms)
        # iLQR per-iter ~4x NLMPC's step (H per-step autograd Jacobians + Cholesky)
        solver_coeff = 0.8 if wildcards.ctrl_type == "iLQR" else 0.2
        per_trial_s = 60.0 + solver_coeff * H
        total_min = (100 * per_trial_s + 60) / 60 * SAFETY_MARGIN
        base = max(FLOOR_MIN, 5 * (int(total_min // 5) + 1))
    return base * attempt


rule ctrl_expts:
    input:
        "src/ctrl/__init__.py",
        "src/ctrl/{ctrl_type}.py",
        cleo_prep=wildcard_path("cleo_prep.pkl.gz"),
        lds_model=wildcard_path("model_fit_lds.pkl.gz"),
        # ctrl_expts unpickles cleo_prep, whose __reduce__ re-runs CleoPrep.build,
        # which EAGERLY reads chr2_4s_fsnn_calibration.json. Declare it (same
        # pattern as rule cleo_prep via _cleo_prep_calibration_input) so the DAG
        # orders ctrl after calibrate_opsin_plant and never runs against a missing
        # JSON — the per-combo sweep wrapper rm's the global JSON to force
        # recalibration, and without this dep a cached cleo_prep.pkl.gz lets ctrl
        # race ahead of the regeneration and crash with FileNotFoundError.
        calibration=lambda wc: (
            [config["cleo_prep"]["opsin_calibration_dir"] + "/chr2_4s_fsnn_calibration.json"]
            if config.get("cleo_prep", {}).get("opsin_plant_class") == "chr2_4s_fsnn"
            else []
        ),
        configfiles=configfile_inputs_excluding_sweeps,
    params:
        step_cfg("cleo_prep", "expts", "ctrl_expts"),
    output:
        data=wildcard_path("ctrl_data.pkl.gz"),
    conda:
        "envs/main.yaml"
    resources:
        # Control loop is pure CPU (scipy L-BFGS-B / torch-CPU + Brian2 cython runtime
        # mode); no rule in src/ctrl/* touches CUDA. Run on CPU to free the rtx6000 GPU
        # it used to reserve+idle for the full multi-hour wall and to shorten queue time.
        slurm_partition="cpu-small",
        gpu=0,
        mem_mb=4000,
        runtime=_ctrl_expts_runtime,
    log:
        wildcard_path("ctrl_expts.log"),
    retries: 1
    script:
        "../src/scripts/ctrl_expts.py"


