def fsnn_inputs(wc):
    inputs = dict(
        main_code="src/fsnn/__init__.py",
        data="src/fsnn/{task}_data.npz",
        task_code="src/fsnn/{task}.py",
    )
    # if train or test, get fsnn from previous step
    if wc.mode == "train":
        inputs["fsnn"] = wildcard_path("fsnn_post_demean.pkl.gz")
    elif wc.mode == "test":
        inputs["fsnn"] = wildcard_path("fsnn_post_train.pkl.gz")
    return inputs


def fsnn_outputs(save_fsnn, save_data):
    outputs = {}
    if save_fsnn:
        outputs["fsnn"] = wildcard_path("fsnn_post_{mode}.pkl.gz")
    if save_data:
        outputs["data"] = wildcard_path("fsnn_{mode}_data.pkl.gz")
    return outputs


def gpu_for_fsnn_train(wc):
    return int(wc["mode"] == "train" and config["train_device"] == "cuda")


def slurm_extra_for_fsnn(wc):
    """Return SLURM partition for fSNN simulation."""
    if gpu_for_fsnn_train(wc):
        return "gpu-rtx6000"
    return "cpu-small"


def fsnn_runtime(wc):
    params = fsnn_params(wc)
    n_train_trials = 0
    n_trials = params["n_init_trials"]
    if wc.get("mode", None) == "train":
        n_train_trials += params["n_main_trials"]
    else:
        n_trials += params["n_main_trials"]
    n_trials += params["n_settle_trials"]

    return runtime_min(n_trials, n_train_trials)


# 3 fsnn rules, flexibly save fSNN and/or data
rule _prep_fsnn:
    input:
        unpack(fsnn_inputs),
    params:
        fsnn_params,
    log:
        wildcard_path("prep_fsnn_{mode}.log"),
    # only use 2 threads; more requires a lot of memory for parallel compilation
    threads: lambda wc: max(1, 4 * gpu_for_fsnn_train(wc))
    resources:
        slurm_partition=slurm_extra_for_fsnn,
        # Track the partition predicate: only mode=train (cuda) needs a GPU; cython
        # demean/test cells route to cpu-small and must not request an unused GPU.
        gpu=gpu_for_fsnn_train,
        runtime=120,
        mem_mb=64000,
    retries: 1
    conda:
        "envs/main.yaml"
    script:
        "../src/scripts/prep_fsnn.py"


use rule _prep_fsnn as prep_fsnn_save_fsnn with:
    output:
        **fsnn_outputs(save_fsnn=True, save_data=False),


use rule _prep_fsnn as prep_fsnn_save_data with:
    output:
        **fsnn_outputs(save_fsnn=False, save_data=True),


use rule _prep_fsnn as prep_fsnn_save_both with:
    output:
        **fsnn_outputs(save_fsnn=True, save_data=True),


# prefer the rule that only saves one thing to the one that saves both
ruleorder: prep_fsnn_save_fsnn > prep_fsnn_save_data > prep_fsnn_save_both


rule plot_schematic:
    input:
        "src/interface_array.py",
        cleo_prep_module=_cleo_prep_module_input,
