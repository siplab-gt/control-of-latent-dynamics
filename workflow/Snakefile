def get_sweep_combinations():
    """Yield dicts of one full cell's wildcards from the Cartesian product
    of `config['sweeps']`. Keys not present in sweeps fall back to
    `config['params']` defaults via `wildcard_path(fill_in_defaults=True)`."""
    sweeps = config.get("sweeps", {})
    if not sweeps:
        yield {}
        return
    keys = list(sweeps.keys())
    values = [list(sweeps[k]) for k in keys]
    for combo in itertools.product(*values):
        yield dict(zip(keys, combo))


def _setting_combos_for(rule_setting):
    """Iterate sweep combinations restricted to a single setting (the rule's
    output filename pins setting). Strips `setting` and `task` from each combo
    — `task` is bound via the rule's `{task}` wildcard, `setting` is fixed."""
    for combo in get_sweep_combinations():
        sweep_setting = combo.get("setting", config["params"]["setting"])
        if sweep_setting != rule_setting:
            continue
        c = {k: v for k, v in combo.items() if k not in ("setting", "task")}
        yield c


