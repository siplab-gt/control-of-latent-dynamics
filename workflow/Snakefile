    output:
        protected("results/optimal_stim_rec_{task}.csv"),
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        print("concatenated optimal stim rec DFs")
        df.to_csv(output[0], index=False)
        print(f"wrote optimal stim rec results to {output[0]}")


def na_wildcards_through_step(desired_step):
    """returns a {wc: "NA"} dict for all wildcards that are irrelevant at and before
    the desired step, i.e., they are introduced later.
    e.g., for model fit, the WCs introduced by ctrl_expts"""
    irrelevant_wcs = []
    for step, step_irrs in [
        ("ctrl_expts", []),
        # introduced by ctrl_expts:
        ("model_fit", ["latency", "ctrl_type"]),
        # introduced by model_fit:
        ("sys_id_expts", ["n_trials_sys_id", "model_task_inputs"]),
        # introduced by sys_id_expts:
        ("cleo_prep", []),
        # introduced by cleo_prep:
        ("prep_fsnn", ["beam_width_um", "signals", "k", "m"]),
        # these change results from the very beginning, with prep_fsnn:
        # n_latent_dims_offset, density_scale, network_area_scale, setting, task, seed
    ]:
        irrelevant_wcs += step_irrs
        if step == desired_step:
            break
    return {wc: NA for wc in irrelevant_wcs}


