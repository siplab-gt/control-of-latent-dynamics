def get_task_params_for_fsnn(wc):
    """gets all train_fsnn params, but only task params as needed"""
    params = config["train_fsnn"]
    try:
        multitask = str2bool(wc.multitask)
    except AttributeError:
        multitask = False
    if multitask:
        task_params = config["train_fsnn"]["task_specific"]
    else:
        task_params = {wc.task: config["train_fsnn"]["task_specific"][wc.task]}
    out = params | task_params
    del out["task_specific"]

    # include array side length since network size depends on it
    out["array_side_length_mm"] = config["cleo_prep"]["array_side_length_mm"]
    out['report_period_s'] = config['report_period_s']
    return out


