rule usid_stim_rec_tabulate:
    input:
        # Single Cartesian-product loop. Every cell in config['sweeps'] ×
        # q_usid (k, m) pairs is a rule input. Params not in sweeps fall back
        # to defaults via fill_in_defaults=True. `task` is bound by the rule's
        # output wildcard; `setting` is pinned to usid_stim_rec.
        [
            wildcard_path(
                file="summary.csv",
                setting="usid_stim_rec",
                k=k,
                m=m,
                **combo,
                fill_in_defaults=True,
            )
            for combo in _setting_combos_for("usid_stim_rec")
