# assume BRAID, GPU, heavier resources when not sufficient stim (known factors)
def gpu_for_model_fit(wc):
    return int(wc.setting != "sufficient_stim" and config["model_fit_device"] == "gpu")


rule model_fit:
    input:
        "src/model_fit/__init__.py",
        method=branch(
            lambda wc: wc.setting == "sufficient_stim",
            then="src/model_fit/known_factors.py",
            otherwise="src/model_fit/braid.py",
        ),
        sys_id_data=wildcard_path("sys_id_data.pkl.gz"),
    params:
        step_cfg("model_fit"),
        braid_basename=wildcard_path("model_fit_braid"),
    output:
        lds_model=wildcard_path("model_fit_lds.pkl.gz"),
        pred_data=wildcard_path("model_fit_pred_data.pkl.gz"),
    threads: lambda wc: max(1, 8 * gpu_for_model_fit(wc))
    resources:
        gpu=gpu_for_model_fit,
        gpu_jobs=gpu_for_model_fit,
        mem_mb=lambda wc: 32000 if wc.setting != "sufficient_stim" else 4000,
        # since slurm executor sets to 1, which breaks
        tasks_per_gpu=0,
        runtime=lambda wc: 120 if wc.setting != "sufficient_stim" else 10,
    retries: 1
    conda:
        "cold"
    log:
        wildcard_path("model_fit.log"),
    script:
        "../src/scripts/model_fit.py"


