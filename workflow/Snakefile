        "scripts/plot_sys_id_data.py"


def task_specific_params(wildcards):
    return params_from_cfg("task_specific", get_children=True)[wildcards["task"]]


rule sys_id_expts:
    input:
        f"results/{params_str}/cleo_prep.pkl",
