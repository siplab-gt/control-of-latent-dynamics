                latency=latency,
                ctrl_type=ctrl,
                k=k,
                m=m,
                seed=config["grid_sweep_params"]["seed"],
                fill_in_ref=True,
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
            for k, m in get_q2_kms()
        ],
        # exploratory variables
        [
            wildcard_path(
                file="summary.csv",
                setting="optimal_stim_rec",
                latency=False,
                ctrl_type="LQMPC",
                k=k,
                m=m,
                seed=config["grid_sweep_params"]["seed"],
                **{var: values},
                fill_in_ref=True,
            )
            for var, values in (
                config["star_sweep_params"]
                | config["star_sweep_params_measurement_only"]
            ).items()
            for k, m in get_q2_kms()
        ],
    output:
        protected("<results>/optimal_stim_rec_{task}.csv"),
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        print("concatenated optimal stim rec DFs")
