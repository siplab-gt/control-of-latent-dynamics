def get_q2_kms():
    if "q2" not in config:
        return iter([])
    budget = int(config["q2"]["channel_budget"])
    kk = np.linspace(
        1, budget - 1, int(config["q2"]["num_stim_ratio_levels"]), endpoint=True
    )
    kk = np.round(kk).astype(int)
    mm = budget - kk
    return zip(kk.tolist(), mm.tolist())


def get_usid_kms():
    budget = int(config["q_usid"]["channel_budget"])
    kk = np.linspace(
        1, budget - 1, int(config["q_usid"]["num_stim_ratio_levels"]), endpoint=True
    )
    kk = np.round(kk).astype(int)
    mm = budget - kk
    pairs = list(zip(kk.tolist(), mm.tolist()))
    # Optional filter: restrict to a single k/m pair by setting q_usid.target_k
    target_k = config["q_usid"].get("target_k")
    if target_k is not None:
        pairs = [(k, m) for (k, m) in pairs if k == int(target_k)]
        if not pairs:
            raise ValueError(
                f"q_usid.target_k={target_k} not found in generated k values {kk.tolist()}"
            )
    return iter(pairs)


test_usid_k, test_usid_m = list(get_usid_kms())[-1]


