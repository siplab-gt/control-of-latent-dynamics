rule sufficient_stim_tabulate:
    input:
        # to get main fig
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                ctrl_type=ctrl,
                m=NA,
                k=config["q1"]["k"],
                seed=config["grid_sweep_params"]["seed"],
                fill_in_ref=True,
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
        ],
        # exploratory variables
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                ctrl_type=ctrl,
                k=config["q1"]["k"],
                m=0,
                seed=config["grid_sweep_params"]["seed"],
                **{var: config["star_sweep_params"][var]},
                fill_in_ref=True,
            )
            for var in config["star_sweep_params"]
            for ctrl, latency in [("OL", False), ("LQMPC", True)]
        ],
    output:
        "results/sufficient_stim__{task}.csv",
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        print("concatenated sufficient stim DFs")
        df.to_csv(output[0], index=False)
        print(f"wrote sufficient stim results to {output[0]}")


def get_q2_kms():
    budget = int(config["q2"]["channel_budget"])
    kk = np.linspace(
        1, budget - 1, int(config["q2"]["num_stim_ratio_levels"]), endpoint=True
    )
    kk = np.round(kk).astype(int)
    mm = budget - kk
    return zip(kk.tolist(), mm.tolist())


rule optimal_stim_rec_tabulate:
    input:
        # to get main fig
        [
            paths_for_params(
                file="summary.csv",
                setting="optimal_stim_rec",
                latency=latency,
                ctrl_type=ctrl,
                k=k,
                m=m,
                seed=config["grid_sweep_params"]["seed"],
                fill_in_ref=True,
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
            for k, m in get_q2_kms()
        ],
        # exploratory variables
        [
            paths_for_params(
                file="summary.csv",
                setting="optimal_stim_rec",
                latency=latency,
                ctrl_type=ctrl,
                k=k,
                m=m,
                seed=config["grid_sweep_params"]["seed"],
                **{var: config["star_sweep_params"][var]},
                fill_in_ref=True,
            )
            for var in config["star_sweep_params"]
            for ctrl, latency in [("OL", False), ("LQMPC", True)]
            for k, m in get_q2_kms()
        ],
    output:
        "results/optimal_stim_rec__{task}.csv",
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        print("concatenated optimal stim rec DFs")
        df.to_csv(output[0], index=False)
        print(f"wrote optimal stim rec results to {output[0]}")


def na_wildcards_through_step(desired_step):
    """returns a {wc: "NA"} dict for all wildcards that are irrelevant at and before
    the desired step, i.e., they are introduced later.
    e.g., for model fit, the WCs introduced by ctrl_expts"""
    irrelevant_wcs = []
    for step, step_irrs in [
        ("ctrl_expts", []),
        # introduced by ctrl_expts:
        ("model_fit", ["latency", "ctrl_type"]),
        # introduced by model_fit:
        ("sys_id_expts", ["n_trials_sys_id", "model_task_inputs"]),
        # introduced by sys_id_expts:
        ("cleo_prep", []),
        # introduced by cleo_prep:
        ("train_fsnn", ["beam_width_um", "beam_spacing", "k", "m"]),
    ]:
        irrelevant_wcs += step_irrs
        if step == desired_step:
            break
    return {wc: NA for wc in irrelevant_wcs}


