def _stim_rec_tabulate_inputs(wildcards):
    """Materialize the Cartesian product of sweep combos × q_usid (k, m) for
    a single stim-rec setting. `task` is stripped from each combo and rebound
    at rule-eval time via the output's {task} wildcard; `setting` is bound by
    the rule's `{setting}` wildcard."""
    return [
        wildcard_path(
            file="summary.csv",
            setting=wildcards.setting,
            k=k,
            m=m,
            **combo,
            fill_in_defaults=True,
        )
        for combo in _setting_combos_for(wildcards.setting)
        for k, m in get_usid_kms()
    ]


def _stim_rec_config_inputs(wildcards):
    """Per-cell config_snapshot.yaml files for a stim-rec setting — one per model_fit
    cell (deduped: many ctrl combos share one model_fit cell). Aggregated into the
    harvest config grid alongside the metrics tabulation."""
    return sorted({
        wildcard_path(
            file="config_snapshot.yaml",
            setting=wildcards.setting,
            k=k,
            m=m,
            **combo,
            fill_in_defaults=True,
        )
        for combo in _setting_combos_for(wildcards.setting)
        for k, m in get_usid_kms()
    })


# Stim-rec tabulator: one rule for usid_stim_rec / usid_stim_rec_no_opsin /
# braid_stim_rec / braid_stim_rec_nonlinear. The setting wildcard is
# constrained to those names so this rule doesn't shadow
# `sufficient_stim_tabulate` / `optimal_stim_rec_tabulate`, which use
# different (k, m) grids.
rule stim_rec_tabulate:
    input:
        summaries=_stim_rec_tabulate_inputs,
        snapshots=_stim_rec_config_inputs,
    output:
        "<results>/{setting}_{task}.csv",
        config_grid="<results>/{setting}_{task}_config_grid.csv",
    wildcard_constraints:
        # stim-rec settings recognized by this tabulator (distinct from the
        # sufficient_stim / optimal_stim_rec grids). usid_loss_* added 2026-05-30
        # for the loss-recovery sweep (same tabulation, new setting names).
        setting="usid_stim_rec|usid_stim_rec_no_opsin|braid_stim_rec|braid_stim_rec_nonlinear|usid_loss_base|usid_loss_roll|usid_loss_acf|usid_loss_both",
    localrule: True
    run:
        # Metrics harvest: concat per-cell summary.csv.
        df = pd.concat([pd.read_csv(f) for f in input.summaries], ignore_index=True)
        df.to_csv(output[0], index=False)
        print(f"wrote {wildcards.setting} results ({len(df)} rows) to {output[0]}")
        # Config grid (realized grid.csv analog): flatten each cell's config_snapshot.yaml
        # and union columns. Drift-free — flattens whatever keys the snapshot has, so a new
        # config/sweep key appears as a new column automatically.
        import os, yaml
        def _flat(o, p=""):
            r = {}
            if isinstance(o, dict):
                for k, v in o.items():
                    r.update(_flat(v, f"{p}{k}."))
            elif isinstance(o, (list, tuple)):
                r[p.rstrip(".")] = repr(list(o))
            else:
                r[p.rstrip(".")] = o
            return r
        rows = []
        for s in input.snapshots:
            try:
                snap = yaml.safe_load(open(s)) or {}
            except Exception as e:
                print(f"  [config-grid skip] {s}: {e}")
                continue
            row = _flat(snap)
            row["_cell_dir"] = os.path.dirname(s)
            rows.append(row)
        pd.DataFrame(rows).to_csv(output.config_grid, index=False)
        print(f"wrote {wildcards.setting} config grid ({len(rows)} cells) to {output.config_grid}")


