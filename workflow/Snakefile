def fsnn_mem_required(wc):
    return 4000 * (1 + float(wc["density_scale"]) * float(wc["network_area_scale"]) / 6)


def runtime_min(n_trials, n_train_trials=0, multiplier=1):
    def f(wc):
        scale = float(wc["density_scale"]) * float(wc["network_area_scale"])
        # observed per-trial runtimes for small networks
        # got 5.4 seconds per trial for demean on big network (*6)
        # get ~1s/trial on Myelin, but ~7 for PACE.
        # actually, around 16 on average for control on PACE.
        # scales less than quadratically
        trial_runtime_min = 16 / 60 * scale**1.2 * multiplier
        # scales quadratically (with synapses)
        train_trial_runtime_min = 60 / 60 * scale**2 * multiplier

        runtime = 2  # overhead
        runtime += n_trials * trial_runtime_min
        runtime += n_train_trials * train_trial_runtime_min
        return ceil(runtime)

    return f


def _ctrl_expts_runtime(wildcards):
    """Empirical wall-time allocation for ctrl_expts, in minutes.

    Observed per-trial wall (NLMPC, 100 trials) from run 6679539 fits
    ~7 + H*N/150 seconds. Total ≈ 100 * per_trial + 1 min setup, scaled
    by SAFETY_MARGIN, rounded up to the next 5-min bin.

    FLOOR_MIN: All controllers get at least 60 min. Originally NULL/OL
    used a flat 30 min on the assumption they're "fast" (no controller
    compute). But the dominant cost for ALL controllers is Brian2 sim
    of the cleo_prep network, which scales with chr2 synapse count
    (= k*m). For dense geometries like (k=22, m=42) → 924 synapses,
    Brian2 sim alone takes ~32 min per cell, busting NULL's 30-min
    cap. The floor covers worst-case Brian2 sim across (k, m) for the
    cheap controllers; the formula still kicks in for NLMPC/LQMPC
    when their solver compute pushes the total above 60 min.

    SAFETY_MARGIN was 1.5; bumped to 2.25 (=1.5×1.5) on 2026-04-28
    after the prior testconfig run hit ~14 NLMPC TIMEOUTs.
    """
    SAFETY_MARGIN = 3.0
    FLOOR_MIN = 60
    if wildcards.ctrl_type in ("NULL", "OL"):
        return FLOOR_MIN
    H = int(wildcards.ctrl_horizon_ms)
    N = int(wildcards.nlmpc_iters)
    per_trial_s = 7 + H * N / 150
    total_min = (100 * per_trial_s + 60) / 60 * SAFETY_MARGIN
    return max(FLOOR_MIN, 5 * (int(total_min // 5) + 1))


rule ctrl_expts:
    input:
