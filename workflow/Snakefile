rule sufficient_stim_tabulate:
    input:
        # expand("results/{params}/{file}", params=paramspace.instance_patterns, ext=[""]),
        # to get main fig
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                ctrl_type=ctrl,
                m=m_sufficient_stim,
                k=config["q1"]["k"],
                seed=config["grid_sweep_conds"]["seed"],
            )
            for ctrl, latency in [("OL", False), ("LQMPC", False), ("LQMPC", True)]
        ],
        # exploratory variables
        [
            paths_for_params(
                file="summary.csv",
                setting="sufficient_stim",
                latency=latency,
                ctrl_type=ctrl,
                k=config["q1"]["k"],
                m=0,
                seed=config["grid_sweep_conds"]["seed"],
                **{var: config["star_sweep_conds"][var]},
            )
            for var in config["star_sweep_conds"]
            for ctrl, latency in [("OL", False), ("LQMPC", True)]
        ],
    output:
        "results/sufficient_stim-{task}.csv",
    localrule: True
    run:
        dfs = [pd.read_csv(infile) for infile in input]
        df = pd.concat(dfs, ignore_index=True)
        df.write_csv(output[0], index=False)


def standard_log_kwargs(log_name):
    return {
        "stdout": f"logs/{params_str}/{log_name}.log",
        "stderr": f"logs/{params_str}/{log_name}.log",
    }


