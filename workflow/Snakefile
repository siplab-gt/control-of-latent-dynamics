        "../src/scripts/plot_cleo.py"


# Mirror of the alias dict in src/scripts/cleo_prep.py — keeps the rule's
# Python-source dependency in sync with what the script actually imports
# at runtime. Multiple settings (e.g. braid_stim_rec, usid_stim_rec_no_opsin)
# share a single cleo_prep module since only the array layout depends on
# `setting`, not the model-fit method.
_CLEO_PREP_MODULE_FOR_SETTING = {
    "sufficient_stim": "sufficient_stim",
    "optimal_stim_rec": "optimal_stim_rec",
    "usid_stim_rec": "usid_stim_rec",
    "usid_stim_rec_no_opsin": "usid_stim_rec",
    "braid_stim_rec": "usid_stim_rec",
    "braid_stim_rec_nonlinear": "usid_stim_rec",
    # loss-recovery sweep settings (2026-05-30): USID method, same array layout.
    "usid_loss_base": "usid_stim_rec",
    "usid_loss_roll": "usid_stim_rec",
    "usid_loss_acf": "usid_stim_rec",
    "usid_loss_both": "usid_stim_rec",
}


def _cleo_prep_module_input(wildcards):
    """Resolve the cleo_prep_*.py source file for a given setting wildcard."""
    return f"src/cleo_prep_{_CLEO_PREP_MODULE_FOR_SETTING[wildcards.setting]}.py"


def _cleo_prep_calibration_input(wildcards):
    """Declare chr2_4s_fsnn_calibration.json as a rule input when the
    configured plant class needs it. cleo_prep.py reads this file eagerly
    inside the chr2_4s_fsnn branch; declaring it as a Snakemake input
    forces the DAG to run calibrate_opsin_plant first."""
    plant = config.get("cleo_prep", {}).get("opsin_plant_class", "proportional_current")
    if plant != "chr2_4s_fsnn":
        return []
    calib_dir = config.get("cleo_prep", {}).get(
        "opsin_calibration_dir", "results/opsin_calibration",
    )
    return [f"{calib_dir}/chr2_4s_fsnn_calibration.json"]


rule cleo_prep:
    input:
        # use NA for wildcards that were irrelevant before this step
        wildcard_path("fsnn_post_train.pkl.gz"),
        "src/grouped_light.py",
        cleo_prep_module=_cleo_prep_module_input,
        interface_array="src/interface_array.py",
        opsins="src/opsins.py",
        calibration=_cleo_prep_calibration_input,
        configfiles=configfile_inputs_excluding_sweeps,
    params:
        step_cfg("prep_fsnn", "cleo_prep"),
    output:
        wildcard_path("cleo_prep.pkl.gz"),
    log:
        wildcard_path("cleo_prep.log"),
    resources:
        gpu=0,
        mem_mb=16000,  # 16GB for loading large fSNN pickle files
        runtime=60,    # 60 min timeout (increased from 30 for LFP jobs)
    retries: 1
    conda:
        "envs/main.yaml"
    script:
        "../src/scripts/cleo_prep.py"


