# =============================================================================
# Model Fit (BRAID, USID, or Known Factors)
# =============================================================================

# Resolve model_fit_method for a given setting wildcard. Looks up in the
# per-setting overlay (config[f"model_fit_{setting}"]) first, then falls
# back to top-level config["model_fit_method"], then to "braid". Lets the
# `setting` wildcard sweep over USID-with-opsin / USID-no-opsin / BRAID by
# putting the right `model_fit_method` (and `use_opsin`) in each per-
# setting `model_fit_<setting>` block.
def _resolve_model_fit_method(setting):
    per_setting = config.get(f"model_fit_{setting}", {}) or {}
    return per_setting.get(
        "model_fit_method", config.get("model_fit_method", "braid")
    )


# Model fit method selection based on config and wildcards
def get_model_fit_method(wildcards):
    """
    Select model_fit method based on config and wildcards.

    Priority:
    1. sufficient_stim setting always uses known_factors
    2. config[f"model_fit_{setting}"]["model_fit_method"] (per-setting override)
    3. config["model_fit_method"] (top-level default)
    4. "braid" (final fallback)
    """
    if wildcards.setting == "sufficient_stim":
        return "src/model_fit/known_factors.py"
    method = _resolve_model_fit_method(wildcards.setting)
    if method == "usid":
        return "src/model_fit/usid.py"
    return "src/model_fit/braid.py"


def get_usid_dependencies(wildcards):
    """
    Return USID repo files as dependencies when model_fit_method=usid.
    This ensures Snakemake reruns model_fit if any USID integration code
    changes. Also includes config/cold_usid.yaml — USID's training
    hyperparams (lr, epochs, rollout, loss_weights) live there and aren't
    otherwise tracked by Snakemake's configfile mechanism, so editing the
    yaml without listing it here would silently leave model_fit outputs
    stale.
    """
    if wildcards.setting == "sufficient_stim":
        return []
    if _resolve_model_fit_method(wildcards.setting) != "usid":
        return []
    usid_repo = os.environ.get("USID_REPO_ROOT", "")
    if not usid_repo:
        raise ValueError(
            "USID_REPO_ROOT not set. Export it to the siplab-gt/usid repo root."
        )
    return [
        "config/cold_usid.yaml",
        f"{usid_repo}/scripts/usid_subspace_interface.py",
        f"{usid_repo}/models/USIDModel.py",
        f"{usid_repo}/models/NaturalModel.py",
        f"{usid_repo}/models/NNOpsinModel.py",
        f"{usid_repo}/models/losses.py",
        f"{usid_repo}/models/base_model.py",
        f"{usid_repo}/models/Parameterization.py",
        f"{usid_repo}/scripts/utils/config_io.py",
        f"{usid_repo}/scripts/utils/checkpoints.py",
        f"{usid_repo}/scripts/usid_data_interface.py",
        f"{usid_repo}/scripts/usid_training_core.py",
        # diagnostics.py / visualizations.py are intentionally NOT tracked: they only
        # produce plots/metrics (run_*_diagnostics in usid.py, now gated off by default)
        # and never affect the returned LDS / model_fit_pred / analysis CSV, so a
        # plot-only edit should not invalidate model_fit and its multi-hour ctrl subtree.
        # They remain ordinary module-level imports at runtime.
    ]


def get_natural_data_input(wildcards):
    """Return natural electrode data path when method=usid, empty list otherwise."""
    if wildcards.setting == "sufficient_stim":
        return []
    if _resolve_model_fit_method(wildcards.setting) != "usid":
        return []
    # natural_electrode is opto-free (zero irradiance) → stim-independent. Pin the
    # sys-ID stim wildcards to their defaults so it is built once and shared across
    # a stim sweep instead of re-simulated per (stim_u_max_mWmm2, stim_active_frac).
    return wildcard_path(
        "natural_electrode_data.pkl.gz",
        stim_u_max_mWmm2=config["params"]["stim_u_max_mWmm2"],
        stim_active_frac=config["params"]["stim_active_frac"],
    )


def _use_opsin_for_setting(setting: str) -> bool:
    """Resolve use_opsin for a given setting, mirroring the model_fit overlay logic."""
    per_setting = config.get(f"model_fit_{setting}", {}) or {}
    if "use_opsin" in per_setting:
        return bool(per_setting["use_opsin"])
    return bool(config.get("use_opsin", False))


def get_cold_opsin_input(wildcards):
    """Sentinel from opsin_train_cold, required only when this setting actually uses opsin.
    Force model_fit/usid.py to consume the cold-trained checkpoint instead of
    silently falling back to USID's synthetic tree."""
    if wildcards.setting == "sufficient_stim":
        return []
    if _resolve_model_fit_method(wildcards.setting) != "usid":
        return []
    if not _use_opsin_for_setting(wildcards.setting):
        return []
    return "results/opsin_train_cold/best_model.path"


# assume GPU-heavy resources when not sufficient stim (BRAID or USID)
def gpu_for_model_fit(wc):
    return int(wc.setting != "sufficient_stim" and config["model_fit_device"] == "gpu")


def slurm_extra_for_model_fit(wc):
    """Return SLURM partition for model fit."""
    if gpu_for_model_fit(wc):
        return "gpu-rtx6000"
    return "cpu-small"


def _voperating_reference_wildcards() -> dict:
    """Representative wildcard combination used for the voperating measurement.

    fSNN's v-distribution is dominated by intrinsic dynamics (not k/m), so
    one representative combo is adequate. Pulls task/seed from config['params']
    defaults so this stays consistent regardless of which axes are being swept.
    """
    try:
        k_val, m_val = next(get_usid_kms())
    except (StopIteration, KeyError):
        k_val, m_val = "NA", "NA"
    return {
        "task": config["params"]["task"],
        "seed": config["params"]["seed"],
        "setting": "usid_stim_rec",
        "k": k_val,
        "m": m_val,
    }


def _voperating_fsnn_input():
    """Resolve the fsnn_post_train.pkl.gz path for the voperating measurement.

    voperating builds its own CleoPrep inline (forcing proportional_current
    plant, see D1 in deviations doc); it does NOT route through the main
    cleo_prep rule. Going through fsnn_post_train.pkl.gz directly breaks
    the circular dep introduced when cleo_prep depends on calibration.
    """
    wc = _voperating_reference_wildcards()
    return wildcard_path(
        "fsnn_post_train.pkl.gz",
        fill_in_defaults=True,
        task=wc["task"],
        seed=wc["seed"],
    )


def _voperating_cond_params(wildcards):
    """cond_params dict for the inline CleoPrep construction."""
    wc = _voperating_reference_wildcards()
    params = config["params"]
    return {
        **wc,
        "n_latent_dims_offset": params["n_latent_dims_offset"],
        "density_scale": params["density_scale"],
        "network_area_scale": params["network_area_scale"],
        "beam_width_um": params["beam_width_um"],
        "signals": params["signals"],
    }


def _voperating_base_params(wildcards):
    """base_params dict (merged prep_fsnn + task-specific overlay + cleo_prep)
    for the inline CleoPrep construction. Mirrors step_cfg('prep_fsnn',
    'cleo_prep') but closed over a fixed task instead of a wildcard."""
    task = config["params"]["task"]
    params = dict(config.get("prep_fsnn", {}))
    params |= config.get(f"prep_fsnn_{task}", {})
    params |= config.get("cleo_prep", {})
    return params


rule measure_voperating_range:
    """Measure fSNN's operational voltage range under sys-ID-style drive
    and emit voperating.json. Prerequisite for rule calibrate_opsin_plant
    (plan §4.1a, deviations doc D1–D2).

    Takes fsnn_post_train.pkl.gz directly (not a CleoPrep) and builds its
    own CleoPrep inline with proportional_current plant — avoids the
    circular dep introduced when the main cleo_prep rule requires a
    chr2_4s_fsnn calibration file (see D1).
    """
    input:
        fsnn=_voperating_fsnn_input(),
        script="src/scripts/measure_voperating_range.py",
        cleo_prep_src="src/scripts/cleo_prep.py",
        configfiles=configfile_inputs_for_voperating,
    output:
        json="results/opsin_calibration/voperating.json",
        png="results/opsin_calibration/voperating.png",
    params:
        cond_params=_voperating_cond_params,
        base_params=_voperating_base_params,
    log:
        "logs/measure_voperating_range.log",
    conda:
        "envs/main.yaml"
    resources:
        mem_mb=16000,
        runtime=30,
    script:
        "../src/scripts/measure_voperating_range.py"


rule calibrate_opsin_plant:
    """Compute (g0, E) from voperating.json via the Bansal-anchored E_RATIO
    placement + a Brian2 long-pulse reference. Writes
    chr2_4s_fsnn_calibration.json with a calibration_hash used as a cache
    key and a provenance fingerprint.

    Plant: Bansal-derived UnitlessChr2FourState (linear V−E driving force);
    no v0/v1 saturation params. The calibration JSON includes a
    `variant: "bansal"` field that cleo_prep.py asserts at load time.

    target_iopto is read from COLD config (`calibrate_opsin_plant.target_iopto`)
    so the calibration tracks config changes. The script requires an explicit
    value — no default — because the calibrated gain has shifted repeatedly
    (0.1 → 0.05 → 0.036) and silent fallbacks would mask stale values."""
    input:
        voperating="results/opsin_calibration/voperating.json",
        script="src/scripts/calibrate_opsin_plant.py",
        opsins="src/opsins.py",
        configfiles=configfile_inputs_excluding_sweeps,
    params:
        target_iopto=lambda wc: config["calibrate_opsin_plant"]["target_iopto"],
        # phim_scale (>1 = less light-sensitive plant) and peak_saturation_bound
        # are optional; default to 1.0 / 0.3 (the script defaults) when absent.
        phim_scale=lambda wc: config["calibrate_opsin_plant"].get("phim_scale", 1.0),
        peak_saturation_bound=lambda wc: config["calibrate_opsin_plant"].get(
            "peak_saturation_bound", 0.3),
        fiber_distance_um=lambda wc: config["calibrate_opsin_plant"].get(
            "fiber_distance_um", 500.0),
        e_ratio=lambda wc: config["calibrate_opsin_plant"].get("e_ratio", 3.5),
    output:
        "results/opsin_calibration/chr2_4s_fsnn_calibration.json",
    log:
        "logs/calibrate_opsin_plant.log",
    conda:
        "envs/main.yaml"
    resources:
        mem_mb=8000,
        runtime=30,
    shell:
        "python -m src.scripts.calibrate_opsin_plant "
        "{input.voperating} {output[0]} "
        "--target-iopto {params.target_iopto} "
        "--phim-scale {params.phim_scale} "
        "--peak-saturation-bound {params.peak_saturation_bound} "
        "--fiber-distance-um {params.fiber_distance_um} "
        "--e-ratio {params.e_ratio} "
        "> {log} 2>&1"


rule opsin_saturation_curve:
    """Steady-state saturation curve + linearity indices of the calibrated
    opsin, consumed by analyze_ctrl_data for the operating-regime control
    metrics (ctrl_opsin_*). Leaf diagnostic mirroring chr2_stability_check:
    reads the calibration JSON, sweeps constant light over the commandable
    range, writes the curve. Reuses the calibrate_opsin_plant bench (one
    source of truth)."""
    input:
        calibration="results/opsin_calibration/chr2_4s_fsnn_calibration.json",
        script="src/scripts/opsin_saturation_curve.py",
        calibrate_src="src/scripts/calibrate_opsin_plant.py",
        opsins="src/opsins.py",
        configfiles=configfile_inputs_excluding_sweeps,
    output:
        "results/opsin_calibration/chr2_4s_fsnn_saturation_curve.json",
    log:
        "logs/opsin_saturation_curve.log",
    conda:
        "envs/main.yaml"
    resources:
        mem_mb=8000,
        runtime=60,
    shell:
        "python -m src.scripts.opsin_saturation_curve "
        "{input.calibration} {output[0]} "
        "> {log} 2>&1"


rule opsin_train_cold:
    """Train COLD's own opsin NN against the calibrated UnitlessChr2FourState
    plant (single-neuron Brian2 sim, no fSNN). Replaces the prior behavior of
    reusing USID's synthetic-tagged opsin checkpoint. Output checkpoint lands
    under ``$USID_REPO_ROOT/experiments/opsin_results_external/cold/`` with
    provenance tag ``external`` + caller_tag ``cold``; ``model_fit/usid.py``
    loads it via ``load_trained_opsin(..., expected_provenance='external')``.

    Snakemake re-runs this rule when the calibration JSON, the script itself,
    or the ``opsin_train_cold`` config block changes. Output sentinel records
    the absolute path of the resulting ``best_model.pth`` so downstream
    consumers can resolve it without recomputing."""
    input:
        calibration="results/opsin_calibration/chr2_4s_fsnn_calibration.json",
        script="src/scripts/opsin_train.py",
        opsins="src/opsins.py",
        configfiles=configfile_inputs_excluding_sweeps,
    output:
        sentinel="results/opsin_train_cold/best_model.path",
    log:
        "logs/opsin_train_cold.log",
    conda:
        "envs/main.yaml"
    threads: 4
    resources:
        # GPU partition for the NN-training half (5000 epochs at hidden_size=32
        # is ~10 min on V100 vs ~100 min on CPU). Brian2 datagen still runs on
        # the same node's CPUs via joblib — GPU just sits idle for ~30 min
        # while datagen finishes, then accelerates the training pass. Memory
        # at 16 GB covers Brian2 cython compile + 4 loky workers; we've seen
        # workers cycle deaths under 16 GB but joblib retries them.
        # Match COLD's other GPU rules (model_fit, ctrl_expts) on rtx6000.
        slurm_partition="gpu-rtx6000",
        gpu=1,
        mem_mb=16000,
        runtime=180,
    script:
        "../src/scripts/opsin_train.py"


rule model_fit:
    input:
        "src/model_fit/__init__.py",
        method=get_model_fit_method,
        usid_deps=get_usid_dependencies,
        natural_data=get_natural_data_input,
        cold_opsin=get_cold_opsin_input,
        sys_id_data=wildcard_path("sys_id_data.pkl.gz"),
        configfiles=configfile_inputs_excluding_sweeps,
    params:
        step_cfg("model_fit"),
        braid_basename=wildcard_path("model_fit_braid"),
    output:
        lds_model=wildcard_path("model_fit_lds.pkl.gz"),
        pred_data=wildcard_path("model_fit_pred_data.pkl.gz"),
        analysis_csv=wildcard_path("model_fit_analysis.csv"),
        config_snapshot=wildcard_path("config_snapshot.yaml"),
    threads: lambda wc: max(1, 8 * gpu_for_model_fit(wc))
    resources:
        slurm_partition=slurm_extra_for_model_fit,
        # Track the partition predicate: cpu-small-routed cells (sufficient_stim, or
        # model_fit_device!=gpu) must NOT also request a GPU (PACE would otherwise
        # reroute them onto a GPU node and allocate an unused one).
        gpu=gpu_for_model_fit,
        mem_mb=32000,
        runtime=180,    # raised 120->180 for n_trials_sys_id=50 + rollout/ACF losses (loss-recovery sweep)
    retries: 1
    conda:
        "envs/main.yaml"
    log:
        wildcard_path("model_fit.log"),
    script:
        "../src/scripts/model_fit.py"


