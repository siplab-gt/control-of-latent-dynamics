# =============================================================================
# Model Fit (BRAID, USID, or Known Factors)
# =============================================================================

# Model fit method selection based on config and wildcards
def get_model_fit_method(wildcards):
    """
    Select model_fit method based on config and wildcards.

    Priority:
    1. sufficient_stim setting always uses known_factors
    2. config["model_fit_method"] selects between "braid" (default) and "usid"
    """
    if wildcards.setting == "sufficient_stim":
        return "src/model_fit/known_factors.py"
    method = config.get("model_fit_method", "braid")
    if method == "usid":
        return "src/model_fit/usid.py"
    return "src/model_fit/braid.py"


def get_usid_dependencies(wildcards):
    """
    Return USID repo files as dependencies when model_fit_method=usid.
    This ensures Snakemake reruns model_fit if any USID integration code
    changes. Also includes config/cold_usid.yaml — USID's training
    hyperparams (lr, epochs, rollout, loss_weights) live there and aren't
    otherwise tracked by Snakemake's configfile mechanism, so editing the
    yaml without listing it here would silently leave model_fit outputs
    stale.
    """
    if wildcards.setting == "sufficient_stim":
        return []
    if config.get("model_fit_method", "braid") != "usid":
        return []
    usid_repo = os.environ.get("USID_REPO_ROOT", "")
    if not usid_repo:
        raise ValueError(
            "USID_REPO_ROOT not set. Export it to the siplab-gt/usid repo root."
        )
    return [
        "config/cold_usid.yaml",
        f"{usid_repo}/scripts/usid_subspace_interface.py",
        f"{usid_repo}/models/USIDModel.py",
        f"{usid_repo}/models/NaturalModel.py",
        f"{usid_repo}/models/NNOpsinModel.py",
        f"{usid_repo}/models/losses.py",
        f"{usid_repo}/models/base_model.py",
        f"{usid_repo}/models/Parameterization.py",
        f"{usid_repo}/scripts/utils/config_io.py",
        f"{usid_repo}/scripts/utils/checkpoints.py",
        f"{usid_repo}/scripts/usid_data_interface.py",
        f"{usid_repo}/scripts/usid_training_core.py",
        f"{usid_repo}/scripts/diagnostics.py",
        f"{usid_repo}/scripts/utils/visualizations.py",
    ]


def get_natural_data_input(wildcards):
    """Return natural electrode data path when method=usid, empty list otherwise."""
    if wildcards.setting == "sufficient_stim":
        return []
    if config.get("model_fit_method", "braid") != "usid":
        return []
    return wildcard_path("natural_electrode_data.pkl.gz")


# assume GPU-heavy resources when not sufficient stim (BRAID or USID)
def gpu_for_model_fit(wc):
    return int(wc.setting != "sufficient_stim" and config["model_fit_device"] == "gpu")


def slurm_extra_for_model_fit(wc):
    """Return SLURM partition for model fit."""
    if gpu_for_model_fit(wc):
        return "gpu-rtx6000"
    return "cpu-small"


def _voperating_reference_wildcards() -> dict:
    """Representative wildcard combination used for the voperating measurement.

    fSNN's v-distribution is dominated by intrinsic dynamics (not k/m), so
    one representative combo is adequate. Pulls task/seed from config['params']
    defaults so this stays consistent regardless of which axes are being swept.
    """
    try:
        k_val, m_val = next(get_usid_kms())
    except (StopIteration, KeyError):
        k_val, m_val = "NA", "NA"
    return {
        "task": config["params"]["task"],
        "seed": config["params"]["seed"],
        "setting": "usid_stim_rec",
        "k": k_val,
        "m": m_val,
    }


def _voperating_fsnn_input():
    """Resolve the fsnn_post_train.pkl.gz path for the voperating measurement.

    voperating builds its own CleoPrep inline (forcing proportional_current
    plant, see D1 in deviations doc); it does NOT route through the main
    cleo_prep rule. Going through fsnn_post_train.pkl.gz directly breaks
    the circular dep introduced when cleo_prep depends on calibration.
    """
    wc = _voperating_reference_wildcards()
    return wildcard_path(
        "fsnn_post_train.pkl.gz",
        fill_in_defaults=True,
        task=wc["task"],
        seed=wc["seed"],
    )


def _voperating_cond_params(wildcards):
    """cond_params dict for the inline CleoPrep construction."""
    wc = _voperating_reference_wildcards()
    params = config["params"]
    return {
        **wc,
        "n_latent_dims_offset": params["n_latent_dims_offset"],
        "density_scale": params["density_scale"],
        "network_area_scale": params["network_area_scale"],
        "beam_width_um": params["beam_width_um"],
        "signals": params["signals"],
    }


def _voperating_base_params(wildcards):
    """base_params dict (merged prep_fsnn + task-specific overlay + cleo_prep)
    for the inline CleoPrep construction. Mirrors step_cfg('prep_fsnn',
    'cleo_prep') but closed over a fixed task instead of a wildcard."""
    task = config["params"]["task"]
    params = dict(config.get("prep_fsnn", {}))
    params |= config.get(f"prep_fsnn_{task}", {})
    params |= config.get("cleo_prep", {})
    return params


rule measure_voperating_range:
    """Measure fSNN's operational voltage range under sys-ID-style drive
    and emit voperating.json. Prerequisite for rule calibrate_opsin_plant
    (plan §4.1a, deviations doc D1–D2).

    Takes fsnn_post_train.pkl.gz directly (not a CleoPrep) and builds its
    own CleoPrep inline with proportional_current plant — avoids the
    circular dep introduced when the main cleo_prep rule requires a
    chr2_4s_fsnn calibration file (see D1).
    """
    input:
        fsnn=_voperating_fsnn_input(),
        script="src/scripts/measure_voperating_range.py",
        cleo_prep_src="src/scripts/cleo_prep.py",
    output:
        json="results/opsin_calibration/voperating.json",
        png="results/opsin_calibration/voperating.png",
    params:
        cond_params=_voperating_cond_params,
        base_params=_voperating_base_params,
    log:
        "logs/measure_voperating_range.log",
    conda:
        "envs/main.yaml"
    resources:
        mem_mb=16000,
        runtime=30,
    script:
        "../src/scripts/measure_voperating_range.py"


rule calibrate_opsin_plant:
    """Compute (g0, E, v0, v1) from voperating.json via published biophysical
    ratios + a Brian2 long-pulse reference (plan §4.3). Writes
    chr2_4s_fsnn_calibration.json with a calibration_hash used as a cache
    key (plan §4.6) and a provenance fingerprint (plan §4.5).

    target_iopto is read from COLD config (`calibrate_opsin_plant.target_iopto`)
    so the calibration tracks config changes. The script requires an explicit
    value — no default — because the calibrated gain has shifted repeatedly
    (0.1 → 0.05 → 0.036) and silent fallbacks would mask stale values."""
    input:
        voperating="results/opsin_calibration/voperating.json",
        script="src/scripts/calibrate_opsin_plant.py",
        opsins="src/opsins.py",
    params:
        target_iopto=lambda wc: config["calibrate_opsin_plant"]["target_iopto"],
    output:
        "results/opsin_calibration/chr2_4s_fsnn_calibration.json",
    log:
        "logs/calibrate_opsin_plant.log",
    conda:
        "envs/main.yaml"
    resources:
        mem_mb=8000,
        runtime=30,
    shell:
        "python -m src.scripts.calibrate_opsin_plant "
        "{input.voperating} {output[0]} "
        "--target-iopto {params.target_iopto} "
        "> {log} 2>&1"


